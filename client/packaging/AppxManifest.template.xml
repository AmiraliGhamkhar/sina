<?xml version="1.0" encoding="utf-8"?>
<!--
  MedicalScribe WPF — MSIX packaging manifest TEMPLATE (Phase 8).

  This file is a documented template, NOT wired into the build: MSIX signing
  and makeappx run on Windows (docs/RELEASE.md §Packaging). Copy into a
  Windows Application Packaging Project created on a Windows machine, then
  fill every {{PLACEHOLDER}}.

  Capabilities: microphone only — no internet declaration needed (the app
  talks to the clinic LAN server via normal sockets; no broadFileSystemAccess,
  no enterpriseAuthentication, no location).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="{{PACKAGE_IDENTITY_NAME}}"
            Publisher="{{PUBLISHER_CN}}"
            Version="{{VERSION}}" />

  <mp:PhoneIdentity PhoneProductId="{{RANDOM_GUID}}" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>MedicalScribe</DisplayName>
    <PublisherDisplayName>{{ORGANIZATION_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us"/>
    <Resource Language="fa-ir"/>
  </Resources>

  <Applications>
    <Application Id="MedicalScribe.WPF" Executable="MedicalScribe.WPF\MedicalScribe.WPF.exe"
                 uap:EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="MedicalScribe"
        Description="Clinical dictation &amp; documentation assistant (assistive use only — output requires clinician review and sign-off)"
        BackgroundColor="#F8FAFC"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png"/>
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <DeviceCapability Name="microphone"/>
  </Capabilities>
</Package>
