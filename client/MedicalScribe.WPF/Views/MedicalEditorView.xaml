<UserControl x:Class="MedicalScribe.WPF.Views.MedicalEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Medical editor" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="{Binding EditorNote}" Foreground="{StaticResource MutedInk}" Margin="0,0,0,10"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Transcript (from live view)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding TranscriptText}" TextWrapping="Wrap" FontSize="13.5"
                                   Foreground="{StaticResource MutedInk}"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Edit buffer" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox Grid.Row="1" Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" FontSize="13.5"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Load transcript into buffer" Style="{StaticResource SecondaryButton}" Command="{Binding LoadTranscriptIntoBufferCommand}"/>
                <Button Content="Apply buffer to transcript" Command="{Binding ApplyBufferToTranscriptCommand}"/>
                <Button Content="New paragraph" Style="{StaticResource SecondaryButton}" Command="{Binding InsertNewParagraphCommand}"/>
                <Button Content="Terminology preview (server)" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding NormalizePreviewCommand}"
                        ToolTip="Reversible server-side canonicalization preview (ام‌آرآی → MRI); the stored transcript keeps the original"/>
            </StackPanel>
            <ListBox HorizontalAlignment="Right" Width="300" Height="90" ItemsSource="{Binding CommandLog}" BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock FontSize="11.5" Foreground="{StaticResource MutedInk}">
                            <Run Text="{Binding Time, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Command, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Detail, Mode=OneWay}"/>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
