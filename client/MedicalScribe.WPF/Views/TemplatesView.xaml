<UserControl x:Class="MedicalScribe.WPF.Views.TemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Report templates" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Templates are data-driven: definitions live server-side, never in XAML." Foreground="{StaticResource MutedInk}" Margin="0,0,0,10"/>
            </StackPanel>
            <Button Content="Refresh from server" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Command="{Binding RefreshCommand}"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <ListBox ItemsSource="{Binding Templates}" SelectedItem="{Binding Selected}" BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="720" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="{StaticResource MutedInk}"/>
                            <TextBlock Grid.Column="2" Text="{Binding SectionsSummary}" Foreground="{StaticResource MutedInk}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="3" Text="{Binding Builtin, Converter={StaticResource TemplateOriginConverter}}" Margin="12,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Phase 6: fork a built-in into an editable custom template -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Fork built-in → custom:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Text="{Binding NewKey, UpdateSourceTrigger=PropertyChanged}" Width="180"
                         ToolTip="New key: a-z 0-9 '-' (2-64 chars), e.g. ct-er-protocol"/>
                <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="8,0,0,0"
                         ToolTip="Display name (optional)"/>
                <Button Content="Fork selected" Margin="8,0,0,0" Command="{Binding ForkSelectedCommand}"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding Note}" Foreground="{StaticResource MutedInk}" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
