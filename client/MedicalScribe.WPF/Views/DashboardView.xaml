<UserControl x:Class="MedicalScribe.WPF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="1000">
            <Grid Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Dashboard" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding ManifestSummary}" Foreground="{StaticResource MutedInk}"/>
                    <TextBlock Text="{Binding UserLabel, StringFormat='Signed in as {0}'}" Foreground="{StaticResource MutedInk}"/>
                </StackPanel>
                <Button Content="Refresh" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Command="{Binding RefreshCommand}"/>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <ItemsControl ItemsSource="{Binding Modules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="10" Padding="10,2">
                                    <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource MutedInk}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="AI providers (server-side)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Providers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Kind}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Description}" Foreground="{StaticResource MutedInk}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Configured, StringFormat='configured: {0}'}" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding LoadError}" Foreground="{StaticResource Danger}"
                               Visibility="{Binding LoadError, Converter={StaticResource NullToCollapsed}}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
