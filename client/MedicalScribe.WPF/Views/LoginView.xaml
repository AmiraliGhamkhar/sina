<UserControl x:Class="MedicalScribe.WPF.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Style="{StaticResource Card}" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Sign in" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding ConnectionHint}" Foreground="{StaticResource MutedInk}" Margin="0,0,0,14"/>

                <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged"/>

                <Button Content="Sign in" Margin="0,16,0,0" HorizontalAlignment="Stretch" Command="{Binding LoginCommand}"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Danger}" Margin="0,10,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
