<UserControl x:Class="MedicalScribe.WPF.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Medical report" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding State, StringFormat='lifecycle: {0}'}" Foreground="{StaticResource MutedInk}"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#EFF6FF" CornerRadius="8" Padding="10,4">
                <TextBlock Text="{Binding State}" FontWeight="SemiBold" Foreground="#1D4ED8" FontSize="12.5"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10">
            <TextBlock Text="{Binding SafetyBanner}" Foreground="#92400E" FontSize="12.5"/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Encounter:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding EncounterId}" Width="140"/>
                    <TextBlock Text="Template:" VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <TextBox Text="{Binding TemplateKey}" Width="200"/>
                    <Button Content="Generate draft" Margin="16,0,0,0" Command="{Binding GenerateCommand}"/>
                    <Button Content="Save edits" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding SaveEditsCommand}"/>
                </StackPanel>
                <TextBox Grid.Row="1" Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontSize="14" BorderThickness="0"
                         VerticalContentAlignment="Top"/>
            </Grid>
        </Border>

        <!-- Phase 6: validation warnings block finalize/approve until acknowledged -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock FontSize="13">
                    <Run Text="Validation warnings (" FontWeight="SemiBold"/>
                    <Run Text="{Binding BlockingCriticals, Mode=OneWay}"/>
                    <Run Text=" blocking critical) — acknowledge each with a recorded justification before finalizing."/>
                </TextBlock>
                <ListBox x:Name="WarningList" Grid.Row="1" ItemsSource="{Binding Warnings}" BorderThickness="0" Background="Transparent"
                         MaxHeight="120" Margin="0,6,0,6" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Severity}" FontWeight="SemiBold"
                                           Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="2" Text="{Binding Acknowledged, Converter={StaticResource BoolToYesNo}}"
                                           Foreground="{StaticResource MutedInk}" Margin="12,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <TextBox Text="{Binding Justification, UpdateSourceTrigger=PropertyChanged}" Width="420"
                             ToolTip="Justification recorded with the acknowledgment (audit trail)"/>
                    <Button Content="Acknowledge selected" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            Command="{Binding AcknowledgeSelectedCommand}"
                            CommandParameter="{Binding SelectedValue, ElementName=WarningList}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Finalize (clinician)" Command="{Binding FinalizeCommand}"/>
                <Button Content="Approve" Style="{StaticResource DangerButton}" Command="{Binding ApproveCommand}"/>
                <Button Content="Reopen for editing" Style="{StaticResource SecondaryButton}" Command="{Binding ReopenDraftCommand}"/>
                <Button Content="Amend (from approved)" Style="{StaticResource SecondaryButton}" Command="{Binding AmendCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding Message}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedInk}"/>
        </Grid>
    </Grid>
</UserControl>
