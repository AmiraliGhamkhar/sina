<UserControl x:Class="MedicalScribe.WPF.Views.ModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="AI models" Style="{StaticResource SectionTitle}"/>
                <TextBlock Foreground="{StaticResource MutedInk}" Margin="0,0,0,10"
                           Text="Downloaded and verified server-side, then auto-configured where possible. Model weights never touch the client."/>
            </StackPanel>
            <Button Content="Refresh" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Command="{Binding RefreshCommand}"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Models}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12" BorderBrush="{StaticResource MutedInk}" BorderThickness="0,0,0,1" Margin="0,2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding License}" Foreground="{StaticResource MutedInk}"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                                   ToolTip="Model license — review before clinical use"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RoleText}"
                                               Foreground="{StaticResource MutedInk}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SizeText}"
                                               Foreground="{StaticResource MutedInk}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding StateText}"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal">
                                        <Button Content="Download" Margin="0,0,8,0" MinWidth="88"
                                                Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanDownload}"/>
                                        <Button Content="Remove" Style="{StaticResource SecondaryButton}" MinWidth="70"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanDelete}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Text="{Binding Description}"
                                               Foreground="{StaticResource MutedInk}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                                    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,6,0,0">
                                        <ProgressBar Minimum="0" Maximum="1" Height="14"
                                                     Value="{Binding ProgressOrZero, Mode=OneWay}"
                                                     Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding Error}" Foreground="#B3261E" TextWrapping="Wrap"
                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding OperatorNote}" Foreground="{StaticResource MutedInk}" TextWrapping="Wrap"
                                                   Visibility="{Binding AutoConfigured, Converter={StaticResource InvBoolToVis}}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding Note}" Foreground="{StaticResource MutedInk}" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
