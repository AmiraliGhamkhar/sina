<Window x:Class="MedicalScribe.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MedicalScribe.WPF.ViewModels"
        xmlns:views="clr-namespace:MedicalScribe.WPF.Views"
        xmlns:infra="clr-namespace:MedicalScribe.WPF.Infrastructure"
        Title="MedicalScribe — clinical dictation &amp; documentation"
        Height="840" Width="1360"
        MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}"><views:LoginView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PatientEncounterViewModel}"><views:PatientEncounterView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecorderViewModel}"><views:RecorderView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LiveTranscriptViewModel}"><views:LiveTranscriptView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MedicalEditorViewModel}"><views:MedicalEditorView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportViewModel}"><views:ReportView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TemplatesViewModel}"><views:TemplatesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AiSettingsViewModel}"><views:AiSettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UserSettingsViewModel}"><views:UserSettingsView/></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1" Padding="18,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚕" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="MedicalScribe" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                             Fill="{Binding UiState, Converter={StaticResource StateBrush}}"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedInk}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <Button Content="Logout" Style="{StaticResource SecondaryButton}" Command="{Binding LogoutCommand}" Padding="10,4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- shell -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,1,0">
                <ListBox Style="{StaticResource NavList}"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNavItem}"
                         Margin="0,12,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,6">
                                <TextBlock Text="{Binding Glyph}" Width="24" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>
