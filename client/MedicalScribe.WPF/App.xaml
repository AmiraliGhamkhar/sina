<Application x:Class="MedicalScribe.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:MedicalScribe.WPF.Infrastructure">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <infra:ConnectionStateToBrushConverter x:Key="StateBrush"/>
            <infra:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <infra:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
            <infra:NullToCollapsedConverter x:Key="NullToCollapsed"/>
            <infra:SeverityToBrushConverter x:Key="SeverityBrush"/>
            <infra:BoolToYesNoConverter x:Key="BoolToYesNo"/>
            <infra:TemplateOriginConverter x:Key="TemplateOriginConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
