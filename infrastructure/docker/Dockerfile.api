# MedicalScribe API image — Python 3.12 per spec (sandbox CI runs 3.11; code
# stays compatible with both). Multi-stage: runtime-only files in the final image.
FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install the project (api + ai packages, per pyproject package discovery)
COPY pyproject.toml README.md ./
COPY backend ./backend
COPY ai ./ai
RUN pip install . \
    && pip install "sqlalchemy[asyncio]>=2.0" "asyncpg>=0.29" "alembic>=1.13" "redis>=5.0" "argon2-cffi>=23.1" "cryptography>=42.0"

# non-root runtime user
RUN useradd --create-home --uid 10001 mscribe && mkdir -p /app/logs && chown -R mscribe /app
USER mscribe

EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
  CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)" || exit 1

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
