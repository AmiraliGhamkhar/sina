<Window x:Class="SpeakType.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpeakType Settings" Height="450" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F3F3F3">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="#333"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Hotkey Section -->
                <TextBlock Text="Global Hotkey" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Border Background="White" CornerRadius="4" Padding="10" Margin="0,0,0,15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="ChkCtrl" Content="Ctrl" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkAlt" Content="Alt" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkShift" Content="Shift" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkWin" Content="Win" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Key:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="TxtKey" Width="100" Padding="5"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Paths Section -->
                <TextBlock Text="Whisper Configuration" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Border Background="White" CornerRadius="4" Padding="10" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Exec Path:" FontSize="11" Foreground="#666" Margin="0,0,0,3"/>
                        <DockPanel Margin="0,0,0,10">
                            <Button Content="..." Width="30" DockPanel.Dock="Right" Margin="5,0,0,0" Click="BrowseWhisper_Click"/>
                            <TextBox x:Name="TxtWhisperPath" Padding="5"/>
                        </DockPanel>

                        <TextBlock Text="Model Path:" FontSize="11" Foreground="#666" Margin="0,0,0,3"/>
                        <DockPanel>
                            <Button Content="..." Width="30" DockPanel.Dock="Right" Margin="5,0,0,0" Click="BrowseModel_Click"/>
                            <TextBox x:Name="TxtModelPath" Padding="5"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Audio Section -->
                <TextBlock Text="Audio" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Border Background="White" CornerRadius="4" Padding="10" Margin="0,0,0,15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Mic Index:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="TxtMicIndex" Width="50" Padding="5"/>
                            <TextBlock Text="(-1 = Auto)" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#666" FontSize="11"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkAudioFeedback" Content="Enable Audio Feedback" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Width="80" Height="30" Margin="0,0,10,0" Click="Save_Click"/>
            <Button Content="Cancel" Width="80" Height="30" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

