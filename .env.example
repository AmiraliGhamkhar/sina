# MedicalScribe — server configuration (backend + AI layer)
# Copy to `.env` and fill in. The WPF client NEVER reads this file.
# Nested settings use `__`:  MS_LLM__LLAMA_SERVER__BASE_URL

# ─── server ────────────────────────────────────────────────────────────────
MS_SERVER__ENV=dev                       # dev | production (production fails fast on weak secrets)
MS_SERVER__HOST=0.0.0.0
MS_SERVER__PORT=8000
MS_SERVER__LOG_LEVEL=INFO
MS_SERVER__LOG_JSON=false

# ─── auth (Phase 7 completes persistence; Phase 1 accepts tokens) ─-----------
# Generate: openssl rand -base64 48
MS_AUTH__JWT_SECRET=
MS_AUTH__ACCESS_TTL_MINUTES=30
# Dev-only static bearer token for local testing (ignored when ENV=production):
MS_AUTH__DEV_TOKEN=

# ─── persistence (Phase 7; readiness probes TCP only until then) ─-------------
MS_DATABASE__URL=postgresql+asyncpg://medicalscribe:medicalscribe@localhost:5432/medicalscribe
MS_REDIS__URL=redis://localhost:6379/0

# ─── AI routing policy (spec §11) ───────────────────────────────────────────
MS_ROUTING__MODE=auto                    # local | cloud | hybrid | auto
MS_ROUTING__PRIVACY_DEFAULT=true         # all encounters private unless overridden

# ─── LLM providers ───────────────────────────────────────────────────────────
# llama.cpp server — EXTERNAL service, never exposed to clients directly
MS_LLM__LLAMA_SERVER__BASE_URL=          # e.g. http://127.0.0.1:8080
MS_LLM__LLAMA_SERVER__MODEL=local
MS_LLM__LLAMA_SERVER__TIMEOUT_S=120
MS_LLM__LLAMA_SERVER__MAX_RETRIES=2
MS_LLM__LLAMA_SERVER__STREAMING=true
# cloud LLMs (Phase 4) — keys stay server-side
# MS_LLM__CLOUD__OPENAI_API_KEY=
# MS_LLM__CLOUD__ANTHROPIC_API_KEY=
# MS_LLM__CLOUD__GEMINI_API_KEY=

# ─── STT providers (Phase 3) ─────────────────────────────────────────────────
MS_STT__DEFAULT_PROVIDER=mock            # Phase 1/2; later: whisper-local | qwen-asr | speechmatics | deepgram
# MS_STT__WHISPER_SERVER__URL=http://127.0.0.1:9000
# MS_STT__DEEPGRAM__API_KEY=
# MS_STT__SPEECHMATICS__API_KEY=

# ─── websocket ───────────────────────────────────────────────────────────────
MS_WEBSOCKET__MAX_MESSAGE_BYTES=1048576
MS_WEBSOCKET__HEARTBEAT_SECONDS=30
MS_WEBSOCKET__MAX_SESSION_MINUTES=120

# ─── security ────────────────────────────────────────────────────────────────
MS_RATE_LIMIT__REQUESTS_PER_MINUTE=120
MS_RATE_LIMIT__AUTH_PER_MINUTE=10
# browser tooling only (WPF does not need CORS): MS_CORS__ALLOW_ORIGINS=["https://admin.example"]

# ─── audit ───────────────────────────────────────────────────────────────────
MS_AUDIT__ENABLED=true
MS_AUDIT__LOG_FILE=logs/audit.jsonl
