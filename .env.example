# MedicalScribe — server configuration (backend + AI layer)
# Copy to `.env` and fill in. The WPF client NEVER reads this file.
# Nested settings use `__`:  MS_LLM__LLAMA_SERVER__BASE_URL

# ─── server ────────────────────────────────────────────────────────────────
MS_SERVER__ENV=dev                       # dev | production (production fails fast on weak secrets)
MS_SERVER__HOST=0.0.0.0
MS_SERVER__PORT=8000
MS_SERVER__LOG_LEVEL=INFO
MS_SERVER__LOG_JSON=false

# ─── auth (Phase 7: credential login + refresh rotation) ─---------------------
# Generate one (PowerShell):  [Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))
# Required for any login, including the dev user below.
MS_AUTH__JWT_SECRET=
MS_AUTH__ACCESS_TTL_MINUTES=30
MS_AUTH__REFRESH_TTL_DAYS=14
# Dev-only static bearer token for local testing (ignored when ENV=production).
# Set it to log in as user `dev` with this value as the password (no database needed).
MS_AUTH__DEV_TOKEN=
# Login lockout (spec §14): N failures → temporary lock
MS_AUTH__LOCKOUT_MAX_FAILURES=5
MS_AUTH__LOCKOUT_SECONDS=300
# Argon2id cost parameters (defaults are the OWASP baseline)
# MS_AUTH__ARGON2_TIME_COST=3
# MS_AUTH__ARGON2_MEMORY_COST=65536
# MS_AUTH__ARGON2_PARALLELISM=4
# First-boot admin bootstrap — ONLY when this password is explicitly set
# (never a default credential). Unset = no admin user is created.
# MS_AUTH__BOOTSTRAP_ADMIN_USERNAME=admin
# MS_AUTH__BOOTSTRAP_ADMIN_PASSWORD=

# ─── persistence (Phase 7) ─────────────────────────────────────────────────────
# Unset = fully functional in-memory dev mode (no durable rows; DB-backed
# routes answer 501 DB_NOT_CONFIGURED). Leave these commented for the
# zero-dependency quick start; uncomment once Postgres/Redis are running
# locally (or when using `docker compose up`, which sets both itself).
# MS_DATABASE__URL=postgresql+asyncpg://medicalscribe:medicalscribe@localhost:5432/medicalscribe
# MS_DATABASE__AUTO_CREATE=true            # dev only — production: alembic upgrade head
# MS_REDIS__URL=redis://localhost:6379/0   # unset = in-process rate limiting + single-worker semantics

# ─── provider-secret encryption (Phase 7) ─────────────────────────────────────
# Fernet key for storing provider API keys encrypted at rest (ai_providers
# table). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Unset = secrets come from env only; admin secret storage is disabled.
# MS_SECURITY__SECRET_ENCRYPTION_KEY=

# ─── AI routing policy (spec §11) ───────────────────────────────────────────
MS_ROUTING__MODE=auto                    # local | cloud | hybrid | auto
MS_ROUTING__PRIVACY_DEFAULT=true         # all encounters private unless overridden
MS_ROUTING__FALLBACK_ENABLED=true        # Phase 5: runtime fallback over the router chain
MS_ROUTING__BUDGET_TOKENS_PER_DAY=0       # LLM token budget/day; 0 = no cap. Exhausted → cloud soft-stop (local-only)
MS_ROUTING__HEALTH_MIRROR_INTERVAL_S=0     # >0 + MS_REDIS__URL: share provider health across workers via Redis
# MS_REDIS__URL=redis://localhost:6379/0   # health mirror target (single-worker deploys: leave unset)

# ─── LLM providers ───────────────────────────────────────────────────────────
# llama.cpp server — EXTERNAL service, never exposed to clients directly
# Set a URL to route to it (e.g. http://127.0.0.1:8080); empty = not routable.
MS_LLM__LLAMA_SERVER__BASE_URL=
MS_LLM__LLAMA_SERVER__MODEL=local
MS_LLM__LLAMA_SERVER__TIMEOUT_S=120
MS_LLM__LLAMA_SERVER__MAX_RETRIES=2
MS_LLM__LLAMA_SERVER__STREAMING=true
# 9Router (https://github.com/decolua/9router) — self-hosted proxy fronting 40+
# upstreams (Claude/GPT/Gemini/Groq/Copilot/…) behind one OpenAI-compatible API
# with account rotation + auto-fallback. LOCAL by default: it normally runs on
# the same host as this backend (its own default port is 20128).
# Routes only once BASE_URL is set. Model ids are "provider/model" — list the
# live catalog with GET /api/v1/providers/9router/models (or the AI Settings
# screen in the desktop client).
# MS_LLM__NINE_ROUTER__BASE_URL=http://127.0.0.1:20128
# MS_LLM__NINE_ROUTER__MODEL=claude/claude-sonnet-4
# MS_LLM__NINE_ROUTER__API_KEY=                    # only if 9router runs with REQUIRE_API_KEY=true
# MS_LLM__NINE_ROUTER__API_PREFIX=/api             # "" behind a proxy that already rewrites /v1/*
# MS_LLM__NINE_ROUTER__PRIVACY_CLASS=local         # local | cloud — set cloud if it relays to cloud accounts
# MS_LLM__NINE_ROUTER__STREAMING=true
# MS_LLM__NINE_ROUTER__TIMEOUT_S=120
# MS_LLM__NINE_ROUTER__MAX_RETRIES=2
# cloud LLMs (Phase 4 — adapters live; routable only with a key) — keys stay server-side
# MS_LLM__CLOUD__OPENAI_API_KEY=
# MS_LLM__CLOUD__OPENAI_MODEL=gpt-4o-mini
# MS_LLM__CLOUD__ANTHROPIC_API_KEY=
# MS_LLM__CLOUD__GEMINI_API_KEY=
# MS_LLM__CLOUD__TIMEOUT_S=120
# MS_LLM__CLOUD__REDACT_PHI_FOR_CLOUD=true     # scrub ids from model input pre-cloud
# NER-based PII redaction (openmed-persian-pii-tookabert; auto-active once the
# model is downloaded via the Models screen — see docs/MODELS.md)
# MS_LLM__CLOUD__PII_NER_ENABLED=true
# MS_LLM__CLOUD__PII_MODEL_DIR=                # empty = auto-resolve from MS_MODELS__DIR
# MS_LLM__CLOUD__PII_REDACT_LABELS=["GIVENNAME","SURNAME","EMAIL","TELEPHONENUM","STREET","BUILDINGNUM","ZIPCODE","IDCARDNUM","SOCIALNUM","TAXNUM","PASSPORTNUM","DRIVERLICENSENUM","CREDITCARDNUMBER"]
# MS_LLM__DEFAULT_PROVIDER=                     # pin an LLM (else the router decides)
# MS_LLM__REPORT_TEMPERATURE=0.2
# MS_LLM__REPORT_MAX_TOKENS=1600
# MS_LLM__REPAIR_ENABLED=true                   # one strict-JSON repair round-trip

# ─── STT providers (Phase 3 — adapters live; providers route only when configured)
MS_STT__DEFAULT_PROVIDER=mock            # whisper-local | qwen-asr | shenava | 9router | speechmatics | deepgram | mock
MS_STT__BATCH_MAX_BYTES=67108864         # POST /api/v1/transcribe/batch upload cap
# whisper.cpp whisper-server (LOCAL; external process, never spawned by the API)
# MS_STT__WHISPER_SERVER__URL=http://127.0.0.1:9000
# MS_STT__WHISPER_SERVER__MODEL=large-v3
# MS_STT__WHISPER_SERVER__HOTWORDS=["furosemide","ECG","laterality"]
# MS_STT__WHISPER_SERVER__VAD_SILENCE_MS=600
# MS_STT__WHISPER_SERVER__VAD_INTERIM_MS=1500
# Qwen2-Audio behind an OpenAI-audio-compatible service (LOCAL)
# MS_STT__QWEN_ASR__URL=http://127.0.0.1:8020
# MS_STT__QWEN_ASR__MODEL=qwen2-audio-instruct
# Shenava Koochik Persian STT (LOCAL; in-process via sherpa-onnx, `local-ai`
# extra). Paths auto-resolve once the model is downloaded from the Models
# screen — set explicitly only for custom files.
# MS_STT__SHENAVA__MODEL_PATH=
# MS_STT__SHENAVA__TOKENS_PATH=
# MS_STT__SHENAVA__NUM_THREADS=2
# MS_STT__SHENAVA__VAD_SILENCE_MS=600
# MS_STT__SHENAVA__VAD_INTERIM_MS=1200
# 9Router STT (LOCAL by default) — Whisper-compatible POST /api/v1/audio/transcriptions
# relayed to whichever upstream the model id names (Groq Whisper, HuggingFace,
# Deepgram, AssemblyAI, Nvidia NIM, Gemini…). The endpoint is request/response,
# so live dictation uses the same VAD-windowed pseudo-streaming as whisper-local.
# List STT-capable models with GET /api/v1/providers/9router/models?kind=stt
# MS_STT__NINE_ROUTER__BASE_URL=http://127.0.0.1:20128
# MS_STT__NINE_ROUTER__MODEL=groq/whisper-large-v3-turbo
# MS_STT__NINE_ROUTER__API_KEY=                    # only if 9router runs with REQUIRE_API_KEY=true
# MS_STT__NINE_ROUTER__API_PREFIX=/api
# MS_STT__NINE_ROUTER__PRIVACY_CLASS=local         # local | cloud
# MS_STT__NINE_ROUTER__RESPONSE_FORMAT=verbose_json # asks OpenAI-shaped upstreams for timed segments
# MS_STT__NINE_ROUTER__HOTWORDS=["furosemide","warfarin","laterality"]
# MS_STT__NINE_ROUTER__VAD_SILENCE_MS=600
# MS_STT__NINE_ROUTER__VAD_INTERIM_MS=1500
# cloud (CLOUD privacy class — never used for privacy-required encounters)
# MS_STT__DEEPGRAM__API_KEY=
# MS_STT__DEEPGRAM__MODEL=nova-2-general
# MS_STT__DEEPGRAM__KEYWORDS=["furosemide","warfarin","laterality"]
# MS_STT__SPEECHMATICS__API_KEY=
# MS_STT__SPEECHMATICS__LANGUAGE=fa
# MS_STT__SPEECHMATICS__OPERATING_DOMAIN=general
# Realtime cluster: eu | us | au | global (auto-routes to the nearest region;
# pin one for data residency). Legacy eu2/us2 name Batch enterprise clusters
# and alias to eu/us for realtime. Batch and realtime are separate address
# spaces — RT_URL / BATCH_URL override either outright.
# MS_STT__SPEECHMATICS__REGION=eu
# MS_STT__SPEECHMATICS__RT_URL=                    # e.g. wss://eu.rt.speechmatics.com/v2
# Realtime WebSocket knobs (StartRecognition.transcription_config)
# MS_STT__SPEECHMATICS__MAX_DELAY=3.5              # seconds to a final result; API allows 0.7–4, clamped
# MS_STT__SPEECHMATICS__ENABLE_PARTIALS=true       # AddPartialTranscript → live interims
# MS_STT__SPEECHMATICS__DIARIZATION=none           # none | speaker | channel | channel_and_speaker
# MS_STT__SPEECHMATICS__RT_DOMAIN=                 # specialized model, e.g. medical
# MS_STT__SPEECHMATICS__RT_SAMPLE_RATE=16000
# MS_STT__SPEECHMATICS__ADDITIONAL_VOCAB=["furosemide","warfarin"]  # a large list can delay session start ~15 s
# MS_STT__SPEECHMATICS__HANDSHAKE_TIMEOUT_S=20
# MS_STT__SPEECHMATICS__RT_IDLE_TIMEOUT_S=30

# ─── websocket ───────────────────────────────────────────────────────────────
MS_WEBSOCKET__MAX_MESSAGE_BYTES=1048576
MS_WEBSOCKET__HEARTBEAT_SECONDS=30
MS_WEBSOCKET__MAX_SESSION_MINUTES=120

# ─── security ────────────────────────────────────────────────────────────────
MS_RATE_LIMIT__ENABLED=true
MS_RATE_LIMIT__REQUESTS_PER_MINUTE=120
MS_RATE_LIMIT__AUTH_PER_MINUTE=10
MS_RATE_LIMIT__WS_SESSIONS_PER_USER=5       # concurrent transcription sessions per user
# browser tooling only (WPF does not need CORS): MS_CORS__ALLOW_ORIGINS=["https://admin.example"]

# ─── observability (Phase 8) ──────────────────────────────────────────────────
# /metrics (Prometheus text) is always served on the API port (edge-blocked).
# Optional OTel tracing needs the observability extra (opentelemetry-*):
# MS_OBSERVABILITY__OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ─── audit ───────────────────────────────────────────────────────────────────
MS_AUDIT__ENABLED=true
MS_AUDIT__LOG_FILE=logs/audit.jsonl

# ─── model hub (Models screen: verified downloads + auto-configure) ───────────
# Artifacts land under MS_MODELS__DIR/{catalog_id}/… — never committed to git,
# never served raw to clients. See docs/MODELS.md for the catalog and licenses.
MS_MODELS__DIR=models
MS_MODELS__BASE_URL=https://huggingface.co    # override for HF mirrors
MS_MODELS__DOWNLOAD_TIMEOUT_S=1800
MS_MODELS__VERIFY_SHA256=true
MS_MODELS__MIN_FREE_DISK_BYTES=2147483648
# Model paths used by the compose profiles (Model hub download paths):
# MS_LLM_GGUF=minicpm5-2b/MiniCPM5-2B-Q4_K_M.gguf            # llama-server model
# MS_WHISPER_GGUF=whisper-large-v3-turbo/whisper-large-v3-turbo-q4_0.gguf
